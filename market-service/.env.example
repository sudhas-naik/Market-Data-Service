# Application
APP_NAME=market-service
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000

# PostgreSQL (use port 5433 when connecting to Docker Compose Postgres from your host)
DATABASE_URL=postgresql+asyncpg://market:market@localhost:5433/market_db

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_QUOTE_TTL_SECONDS=10

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CLIENT_ID=market-service
KAFKA_TOPIC_QUOTE_UPDATED=market.quote.updated
KAFKA_TOPIC_TICK=market.tick
KAFKA_TOPIC_CANDLE_COMPLETED=market.candle.completed
KAFKA_TOPIC_NEWS=market.news

# Zerodha Market Provider
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=
ZERODHA_REQUEST_TOKEN=
ZERODHA_DEFAULT_EXCHANGE=NSE

# Workers
QUOTE_REFRESH_INTERVAL_SECONDS=1
NEWS_FETCH_INTERVAL_SECONDS=300

# Firebase Authentication
FIREBASE_AUTH_ENABLED=true
FIREBASE_PROJECT_ID=your-firebase-project-id

# Option A: individual service account fields (from Firebase Console JSON key)
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_CLIENT_X509_CERT_URL=

# Option B: path to downloaded JSON file
# FIREBASE_CREDENTIALS_PATH=./secrets/firebase-credentials.json

# Option C: full JSON on one line
# FIREBASE_CREDENTIALS_JSON=

# Validate: uv run python scripts/validate_firebase.py
FIREBASE_AUTH_DEV_BYPASS=false
